# =============================================================================
# .gitignore Raiz — Sistema de Carpinteria SW2 (Monorepo)
# =============================================================================

# --- Variables de Entorno y Secretos ---
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# --- Sistema Operativo e IDEs ---
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~

# --- Logs y Temporales ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Backend 1: Java / Spring Boot (Gradle) ---
.gradle/
**/build/
!**/src/**/build/
**/bin/
!**/src/**/bin/
**/out/
.kotlin/

# --- Backend 2 & Frontends (Node.js / NestJS / React / Angular / Svelte) ---
**/node_modules/
**/dist/
**/dist-mfe/
**/.angular/
**/.svelte-kit/
**/*.tsbuildinfo
**/*.timestamp-*
**/*.local
Backend2-NestJS-Gateway/uploads/

# --- Backend 3: Python (FastAPI / IA / MCP) ---
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.venv/
**/venv/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
Backend3-Python-IA-MCP/training/dataset/
Backend3-Python-IA-MCP/training/dataset_split/
Backend3-Python-IA-MCP/training/.venv-train/
Backend3-Python-IA-MCP/runs/
Backend3-Python-IA-MCP/**/*.pt

# --- Backend 4: PHP (Laravel / DomPDF) ---
Backend4-PHP-Recibos/vendor/
Backend4-PHP-Recibos/.phpunit.result.cache
Backend4-PHP-Recibos/public/build/
Backend4-PHP-Recibos/public/hot
Backend4-PHP-Recibos/storage/*.key
Backend4-PHP-Recibos/storage/logs/*.log
Backend4-PHP-Recibos/storage/framework/views/*.php
Backend4-PHP-Recibos/storage/framework/cache/data/*
Backend4-PHP-Recibos/storage/framework/sessions/*
Backend4-PHP-Recibos/storage/app/invoices/*.pdf
Backend4-PHP-Recibos/storage/app/public/*.pdf
Backend4-PHP-Recibos/bootstrap/cache/*.php
!Backend4-PHP-Recibos/storage/**/.gitignore
!Backend4-PHP-Recibos/bootstrap/cache/.gitignore
