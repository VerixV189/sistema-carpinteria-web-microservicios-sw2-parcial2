APP_NAME="Billing Service"
APP_ENV=local
APP_KEY=base64:REEMPLAZAR_CON_php_artisan_key:generate
APP_DEBUG=true
APP_URL=http://localhost:8001

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=localhost
# Puerto host del postgres de Docker (interno sigue en 5432 en la red compose)
DB_PORT=15432
DB_DATABASE=carpinteria_billing
DB_USERNAME=carpinteria
DB_PASSWORD=carpinteria

# MinIO (S3 compatible)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=carpinteria
AWS_SECRET_ACCESS_KEY=carpinteria123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=invoices
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# RabbitMQ — consume payment.completed
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=carpinteria
RABBITMQ_PASSWORD=carpinteria
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=carpinteria.events

# n8n webhook (atajo documentado: email/WhatsApp via n8n)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/invoice-generated

# GraphQL del business-service (para datos de pedido/cliente)
BUSINESS_GRAPHQL_URL=http://localhost:8080/graphql
INTERNAL_SECRET=carpinteria-internal-dev
WEBHOOK_SECRET=carpinteria-webhook-dev
