{
  "name": "api-gateway-service",
  "version": "1.0.0",
  "description": "API Gateway + Cotizaciones (CU3) + Pasarela de Pago (CU6) — NestJS/TypeScript. Entrada única del sistema: JWT, proxy a Java/Python/PHP, WebSocket, rate-limit.",
  "license": "UNLICENSED",
  "scripts": {
