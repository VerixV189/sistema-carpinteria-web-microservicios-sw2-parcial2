        "jsCode": "// Filtra mensajes entrantes reales de WAHA\n// Payload: { event:'message', session, payload:{ from, body, fromMe, ... } }\nconst w = $json.body || $json;\nconst m = w.payload || w;\nconst ok = w.event === 'message' && m.body && typeof m.body === 'string' && !m.fromMe && m.from && m.from.endsWith('@c.us');\nreturn [{ json: { ok, chatId: m.from, text: (m.body || '').trim(), fromName: m._data?.notifyName || m.from } }];"
      },
      "id": "b1b2c3d4-0006-4000-8000-000000000002",
