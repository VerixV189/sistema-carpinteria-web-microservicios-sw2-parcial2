PORT=8100
MCP_PORT=8110

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=30

BUSINESS_SERVICE_URL=http://localhost:8080

POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=carpinteria
POSTGRES_PASSWORD=carpinteria
POSTGRES_DB=carpinteria

MONGO_URI=mongodb://carpinteria:carpinteria@localhost:27017/carpinteria?authSource=admin
RABBITMQ_URL=amqp://carpinteria:carpinteria@localhost:5672
RABBITMQ_EXCHANGE=carpinteria.events
INTERNAL_SECRET=carpinteria-internal-dev
MCP_API_KEY=carpinteria-mcp-dev
POSTGRES_RO_USER=carpinteria_ro
POSTGRES_RO_PASSWORD=carpinteria_ro_dev

# LLM del agente/reportes — si hay GROQ_API_KEY tiene prioridad sobre Ollama
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Visión para clasificar muebles por foto — si hay GEMINI_API_KEY reemplaza la heurística
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Voz para respuestas del agente (opcional, /ai/tts)
ELEVENLABS_API_KEY=
